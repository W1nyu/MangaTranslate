# Copy this file to local-server/.env and enter only your own API keys.
# Do not commit local-server/.env or paste its contents into an issue/chat.
#
# PowerShell (run from local-server):
#   Copy-Item .env.example .env
#   notepad .env

# Azure Translator in Foundry Tools (F0 = 2 million characters/month free)
# Create a Translator resource in Azure Portal (or from "Free services" on an
# Azure free/student account), then copy a key and its region (Location) from
# "Keys and Endpoint". Keep the default global endpoint below; a resource
# endpoint such as https://<name>.cognitiveservices.azure.com/ also works and
# is required if the resource only allows selected networks.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# DeepL API Free
# Copy the Authentication Key from the DeepL API Keys page. A Free key normally
# ends in ":fx". Keep the Free endpoint below (not the Pro endpoint).
DEEPL_AUTH_KEY=
DEEPL_API_ENDPOINT=https://api-free.deepl.com/v2

# Korean output from DeepL gets webtoon-dialogue style instructions (keep 반말
# for casual lines, drop literal 그는/그녀는). They are not billed but add about
# 0.3 s per request. Set to 0 to turn them off.
DEEPL_WEBTOON_STYLE=1

# ---------------------------------------------------------------------------
# OCR engine
#
# auto (default): run PaddleOCR's official ONNX models on ONNX Runtime - about
#   8x faster on CPU - and fall back to Paddle Inference if they cannot load.
#   The ONNX models (~5-8 MB each) download once, on first use.
# paddle: always use Paddle Inference (the previous, slower behaviour).
# ---------------------------------------------------------------------------
OCR_ENGINE=auto

# ---------------------------------------------------------------------------
# Paid fallback (optional)
#
# These keys are used only after every free engine above has failed AND the
# extension's "무료 한도가 끝나면 유료 API로 계속 번역" checkbox is on. Leaving
# them empty keeps this build free-only: an exhausted quota simply stops
# translating.
# ---------------------------------------------------------------------------

# DeepL API Pro. A different key and a different host from the Free plan; a
# Free key (ending in ":fx") is rejected here and is treated as "not set".
DEEPL_PRO_AUTH_KEY=
DEEPL_PRO_API_ENDPOINT=https://api.deepl.com/v2

# Azure Translator on a billed tier (S1 and up). Use a separate resource, or
# the same resource after upgrading it from F0.
AZURE_TRANSLATOR_PAID_KEY=
AZURE_TRANSLATOR_PAID_REGION=
AZURE_TRANSLATOR_PAID_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Characters per calendar month the paid engines may translate before the
# server refuses to spend more. The count is kept in local-server/.paid-usage.json
# and survives a restart. Set to 0 to remove the cap entirely.
PAID_MONTHLY_CHAR_LIMIT=500000
